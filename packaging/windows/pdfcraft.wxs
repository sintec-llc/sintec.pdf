<?xml version="1.0" encoding="utf-8"?>
<!--
  Sintec.PDF MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build pdfcraft.wxs installer-ui.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, a desktop shortcut (on by default,
  optional), an App Paths entry, and Sintec.PDF registered as a PDF handler (offered under "Open with"
  and in Default apps, never forced as the default). Files opened with Sintec.PDF arrive on its
  command line.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Sintec.PDF"
      Manufacturer="Sintec LLC"
      Version="$(var.Version)"
      UpgradeCode="771EA5E3-78D5-4B1D-B5BD-193072EFB0B7"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Sintec.PDF" Manufacturer="Sintec LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Sintec.PDF is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows Installer requires an Icon id ending in .ico or .exe, or advertised shortcuts and
         Add/Remove Programs show a blank icon (#57). -->
    <Icon Id="PdfcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PdfcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/sintec-llc/sintec.pdf" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/sintec-llc/sintec.pdf/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/sintec-llc/sintec.pdf/issues" />
    <!-- Desktop shortcut (#143): on by default, a checkbox in the full-UI welcome dialog, and
         INSTALLDESKTOPSHORTCUT=0 on the msiexec command line for unattended installs. Secure, so the
         choice made in the (unelevated) UI reaches the elevated install. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />
    <UIRef Id="PdfcraftInstallerUI" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Sintec.PDF" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Sintec.PDF" Level="1">
      <ComponentGroupRef Id="PdfcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="PdfcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="PdfcraftApp" Guid="77463CAA-0061-4070-AC61-59682288BAE4">
        <File Id="PdfcraftExe" Source="$(var.BinDir)\sintec-pdf.exe" KeyPath="yes" />

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\sintec-pdf.exe" Value="[#PdfcraftExe]" Type="string" />

        <!-- PDF files (#107): Sintec.PDF is offered under "Open with" and in Settings ▸ Default
             apps, through Windows' Default Programs registration (a ProgID, OpenWithProgids,
             Capabilities and RegisteredApplications). It never takes over an existing default:
             .pdf's own default value is left alone, and the user chooses. Without this, the only
             Sintec.PDF entry to pick was the advertised Start Menu shortcut, which Windows can't
             run as a file handler ("This app can't run on your PC"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\SintecPDF.Document" Value="PDF Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SintecPDF.Document\DefaultIcon" Value="[#PdfcraftExe],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SintecPDF.Document\shell\open\command" Value="&quot;[#PdfcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdf\OpenWithProgids" Name="SintecPDF.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sintec-pdf.exe" Name="FriendlyAppName" Value="Sintec.PDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sintec-pdf.exe\SupportedTypes" Name=".pdf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sintec-pdf.exe\shell\open\command" Value="&quot;[#PdfcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sintec.PDF\Capabilities" Name="ApplicationName" Value="Sintec.PDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sintec.PDF\Capabilities" Name="ApplicationDescription" Value="Open-source PDF workbench" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sintec.PDF\Capabilities" Name="ApplicationIcon" Value="[#PdfcraftExe],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sintec.PDF\Capabilities\FileAssociations" Name=".pdf" Value="SintecPDF.Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="Sintec.PDF" Value="Software\Sintec.PDF\Capabilities" Type="string" />

        <!-- Image context menu (#190): convert without changing image file defaults. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\SintecPDF.CreatePdf" Value="Create PDF with Sintec.PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\SintecPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\SintecPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\SintecPDF.CreatePdf" Value="Create PDF with Sintec.PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\SintecPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\SintecPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\SintecPDF.CreatePdf" Value="Create PDF with Sintec.PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\SintecPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\SintecPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\SintecPDF.CreatePdf" Value="Create PDF with Sintec.PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\SintecPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\SintecPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\SintecPDF.CreatePdf" Value="Create PDF with Sintec.PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\SintecPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\SintecPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\SintecPDF.CreatePdf" Value="Create PDF with Sintec.PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\SintecPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\SintecPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\SintecPDF.CreatePdf" Value="Create PDF with Sintec.PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\SintecPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\SintecPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\SintecPDF.CreatePdf" Value="Create PDF with Sintec.PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\SintecPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\SintecPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\SintecPDF.CreatePdf" Value="Create PDF with Sintec.PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\SintecPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\SintecPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\SintecPDF.CreatePdf" Value="Create PDF with Sintec.PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\SintecPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\SintecPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
      </Component>

      <!-- Shortcuts (#143) are plain links to sintec-pdf.exe, not advertised MSI shortcuts: advertised
           ones point at a Windows Installer descriptor rather than the program, which Windows can't
           use as a file handler (#107), and 0.2.1's advertised one went missing from the Start menu
           (#143). Each has its own component with an HKLM key path, so Windows Installer removes it
           on uninstall; in this per-machine package both folders are the all-users ones. -->
      <Component Id="PdfcraftStartMenuShortcut" Directory="ProgramMenuFolder" Guid="30AC2B2C-EF3C-4708-A6E7-7047DC899105">
        <Shortcut Id="StartMenuShortcut" Name="Sintec.PDF" Description="Sintec.PDF"
            Target="[#PdfcraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="PdfcraftIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Sintec.PDF\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="PdfcraftDesktopShortcut" Directory="DesktopFolder" Guid="6AF6FF83-79BD-4147-B0C8-A4539F366201"
          Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="Sintec.PDF" Description="Sintec.PDF"
            Target="[#PdfcraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="PdfcraftIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Sintec.PDF\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="PdfcraftCli">
        <File Id="PdfcraftCliExe" Source="$(var.BinDir)\sintec-pdf-cli.exe" KeyPath="yes" />
      </Component>

      <!-- OCR models (CC-BY-SA-4.0, licences alongside) in models\ beside the exe, where
           pdfcraft_ocr::Models::find looks, so Scan & OCR works offline right after install. -->
      <Component Id="PdfcraftOcrModels" Subdirectory="models" Guid="CF874DC8-D68A-4AEA-ABD9-0E63A3992E5F">
        <File Id="OcrDetectionModel" Source="$(var.BinDir)\models\text-detection.rten" KeyPath="yes" />
        <File Id="OcrRecognitionModel" Source="$(var.BinDir)\models\text-recognition.rten" />
        <File Id="OcrDetectionLicence" Source="$(var.BinDir)\models\text-detection.rten.LICENCE.txt" />
        <File Id="OcrRecognitionLicence" Source="$(var.BinDir)\models\text-recognition.rten.LICENCE.txt" />
      </Component>

      <!-- Cyrillic OCR models (PP-OCRv5, Apache-2.0, licences alongside): Russian, Ukrainian and
           Belarusian, found by pdfcraft_ocr::CyrillicModels::find in the same folder. -->
      <Component Id="PdfcraftOcrCyrillic" Subdirectory="models" Guid="25AC6C1B-E839-4400-A51B-A3073B4A0932">
        <File Id="OcrCyrDetectionModel" Source="$(var.BinDir)\models\pp-ocrv5_mobile_det.onnx" KeyPath="yes" />
        <File Id="OcrCyrRecognitionModel" Source="$(var.BinDir)\models\eslav_pp-ocrv5_mobile_rec.onnx" />
        <File Id="OcrCyrDictionary" Source="$(var.BinDir)\models\ppocrv5_eslav_dict.txt" />
        <File Id="OcrCyrDetectionLicence" Source="$(var.BinDir)\models\pp-ocrv5_mobile_det.onnx.LICENCE.txt" />
        <File Id="OcrCyrRecognitionLicence" Source="$(var.BinDir)\models\eslav_pp-ocrv5_mobile_rec.onnx.LICENCE.txt" />
        <File Id="OcrCyrDictionaryLicence" Source="$(var.BinDir)\models\ppocrv5_eslav_dict.txt.LICENCE.txt" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
