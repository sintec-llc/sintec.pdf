        <File Id="OcrTamlRecognition" Source="$(var.BinDir)\models\ta_pp-ocrv5_mobile_rec.onnx" />
        <File Id="OcrTamlDictionary" Source="$(var.BinDir)\models\ppocrv5_ta_dict.txt" />
        <File Id="OcrTamlRecognitionLicence" Source="$(var.BinDir)\models\ta_pp-ocrv5_mobile_rec.onnx.LICENCE.txt" />
