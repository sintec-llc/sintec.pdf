        <File Id="OcrLatnRecognitionLicence" Source="$(var.BinDir)\models\latin_pp-ocrv5_mobile_rec.onnx.LICENCE.txt" />
        <File Id="OcrLatnDictionaryLicence" Source="$(var.BinDir)\models\ppocrv5_latin_dict.txt.LICENCE.txt" />
        <File Id="OcrHaniRecognition" Source="$(var.BinDir)\models\pp-ocrv5_mobile_rec.onnx" />
        <File Id="OcrHaniDictionary" Source="$(var.BinDir)\models\ppocrv5_dict.txt" />
        <File Id="OcrHaniRecognitionLicence" Source="$(var.BinDir)\models\pp-ocrv5_mobile_rec.onnx.LICENCE.txt" />
        <File Id="OcrHaniDictionaryLicence" Source="$(var.BinDir)\models\ppocrv5_dict.txt.LICENCE.txt" />
        <File Id="OcrKoreRecognition" Source="$(var.BinDir)\models\korean_pp-ocrv5_mobile_rec.onnx" />
        <File Id="OcrKoreDictionary" Source="$(var.BinDir)\models\ppocrv5_korean_dict.txt" />
        <File Id="OcrKoreRecognitionLicence" Source="$(var.BinDir)\models\korean_pp-ocrv5_mobile_rec.onnx.LICENCE.txt" />
        <File Id="OcrKoreDictionaryLicence" Source="$(var.BinDir)\models\ppocrv5_korean_dict.txt.LICENCE.txt" />
        <File Id="OcrArabRecognition" Source="$(var.BinDir)\models\arabic_pp-ocrv5_mobile_rec.onnx" />
        <File Id="OcrArabDictionary" Source="$(var.BinDir)\models\ppocrv5_arabic_dict.txt" />
        <File Id="OcrArabRecognitionLicence" Source="$(var.BinDir)\models\arabic_pp-ocrv5_mobile_rec.onnx.LICENCE.txt" />
        <File Id="OcrArabDictionaryLicence" Source="$(var.BinDir)\models\ppocrv5_arabic_dict.txt.LICENCE.txt" />
        <File Id="OcrDevaRecognition" Source="$(var.BinDir)\models\devanagari_pp-ocrv5_mobile_rec.onnx" />
        <File Id="OcrDevaDictionary" Source="$(var.BinDir)\models\ppocrv5_devanagari_dict.txt" />
        <File Id="OcrDevaRecognitionLicence" Source="$(var.BinDir)\models\devanagari_pp-ocrv5_mobile_rec.onnx.LICENCE.txt" />
        <File Id="OcrDevaDictionaryLicence" Source="$(var.BinDir)\models\ppocrv5_devanagari_dict.txt.LICENCE.txt" />
        <File Id="OcrGrekRecognition" Source="$(var.BinDir)\models\el_pp-ocrv5_mobile_rec.onnx" />
        <File Id="OcrGrekDictionary" Source="$(var.BinDir)\models\ppocrv5_el_dict.txt" />
