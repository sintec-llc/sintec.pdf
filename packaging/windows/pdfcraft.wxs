      </Component>

      <!-- Shortcuts (#143) are plain links to sintec-pdf.exe, not advertised MSI shortcuts: advertised
           ones point at a Windows Installer descriptor rather than the program, which Windows can't
           use as a file handler (#107), and 0.2.1's advertised one went missing from the Start menu
           (#143). Each has its own component with an HKLM key path, so Windows Installer removes it
           on uninstall; in this per-machine package both folders are the all-users ones. -->
      <Component Id="PdfcraftStartMenuShortcut" Directory="ProgramMenuFolder" Guid="30AC2B2C-EF3C-4708-A6E7-7047DC899105">
        <Shortcut Id="StartMenuShortcut" Name="Sintec.PDF" Description="Sintec.PDF"
            Target="[#PdfcraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="PdfcraftIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Sintec.PDF\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="PdfcraftDesktopShortcut" Directory="DesktopFolder" Guid="6AF6FF83-79BD-4147-B0C8-A4539F366201"
          Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="Sintec.PDF" Description="Sintec.PDF"
            Target="[#PdfcraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="PdfcraftIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Sintec.PDF\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- PDF context menu (#682): "Edit with PdfCraft" opens the file in PdfCraft whichever app is
           the default for .pdf, which it leaves alone (SystemFileAssociations, like the image
           menu). Several PDFs selected (up to 15, Windows' limit for this kind of entry) start one
           launch each, and the single-instance hand-off opens them as tabs of one window. On
           Windows 11 the entry is under "Show more options": the first-level menu only takes
           packaged apps' (IExplorerCommand) entries. Its own component with an HKLM key path, so
           INSTALLPDFCONTEXTMENU=0 leaves it out and uninstall removes it. -->
      <Component Id="PdfcraftPdfContextMenu" Guid="439F084F-657D-4AC2-A4CC-F099C518D71F"
          Condition="INSTALLPDFCONTEXTMENU = 1">
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\PdfCraft.Edit" Value="Edit with PdfCraft" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\PdfCraft.Edit" Name="Icon" Value="&quot;[#PdfcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\PdfCraft.Edit" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\PdfCraft.Edit\command" Value="&quot;[#PdfcraftExe]&quot; &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="PdfcraftCli">
        <File Id="PdfcraftCliExe" Source="$(var.BinDir)\sintec-pdf-cli.exe" KeyPath="yes" />
      </Component>

      <!-- The project's licences, NOTICE, the PDF file icon's ISC notice and the licences of the
           fonts built into the exe travel with the binaries. -->
      <Component Id="Licence0">
        <File Id="LicenceFile0" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
      </Component>
      <Component Id="Licence1">
        <File Id="LicenceFile1" Source="$(var.BinDir)\LICENSE-APACHE" KeyPath="yes" />
      </Component>
      <Component Id="Licence2">
        <File Id="LicenceFile2" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
      <Component Id="Licence3">
        <File Id="LicenceFile3" Source="$(var.BinDir)\LICENSE-document.txt" KeyPath="yes" />
      </Component>
      <Component Id="Licence4">
        <File Id="LicenceFile4" Source="$(var.BinDir)\OFL-Inter.txt" KeyPath="yes" />
      </Component>
      <Component Id="Licence5">
        <File Id="LicenceFile5" Source="$(var.BinDir)\OFL-JetBrainsMono.txt" KeyPath="yes" />
      </Component>
      <Component Id="Licence6">
        <File Id="LicenceFile6" Source="$(var.BinDir)\OFL-DancingScript.txt" KeyPath="yes" />
      </Component>
      <Component Id="Licence7">
        <File Id="LicenceFile7" Source="$(var.BinDir)\OFL-MarckScript.txt" KeyPath="yes" />
      </Component>

      <!-- OCR models (CC-BY-SA-4.0, licences alongside) in models\ beside the exe, where
           pdfcraft_ocr::Models::find looks, so Scan & OCR works offline right after install. -->
      <Component Id="PdfcraftOcrModels" Subdirectory="models" Guid="CF874DC8-D68A-4AEA-ABD9-0E63A3992E5F">
        <File Id="OcrDetectionModel" Source="$(var.BinDir)\models\text-detection.rten" KeyPath="yes" />
        <File Id="OcrRecognitionModel" Source="$(var.BinDir)\models\text-recognition.rten" />
        <File Id="OcrDetectionLicence" Source="$(var.BinDir)\models\text-detection.rten.LICENCE.txt" />
        <File Id="OcrRecognitionLicence" Source="$(var.BinDir)\models\text-recognition.rten.LICENCE.txt" />
      </Component>

      <!-- PP-OCRv5 detector and East Slavic models (Apache-2.0, licences alongside): Russian,
           Ukrainian and Belarusian, found by pdfcraft_ocr::PaddleModels::find in the same folder. -->
      <Component Id="PdfcraftOcrCyrillic" Subdirectory="models" Guid="25AC6C1B-E839-4400-A51B-A3073B4A0932">
        <File Id="OcrCyrDetectionModel" Source="$(var.BinDir)\models\pp-ocrv5_mobile_det.onnx" KeyPath="yes" />
        <File Id="OcrCyrRecognitionModel" Source="$(var.BinDir)\models\eslav_pp-ocrv5_mobile_rec.onnx" />
        <File Id="OcrCyrDictionary" Source="$(var.BinDir)\models\ppocrv5_eslav_dict.txt" />
        <File Id="OcrCyrDetectionLicence" Source="$(var.BinDir)\models\pp-ocrv5_mobile_det.onnx.LICENCE.txt" />
        <File Id="OcrCyrRecognitionLicence" Source="$(var.BinDir)\models\eslav_pp-ocrv5_mobile_rec.onnx.LICENCE.txt" />
        <File Id="OcrCyrDictionaryLicence" Source="$(var.BinDir)\models\ppocrv5_eslav_dict.txt.LICENCE.txt" />
      </Component>

      <!-- PP-OCRv5 recognition models and dictionaries for the other scripts (Apache-2.0, licences
           alongside), found by pdfcraft_ocr::PaddleModels::find; they share the detector above. -->
      <Component Id="PdfcraftOcrScripts" Subdirectory="models" Guid="0EED101A-4578-43DE-B18F-6112BB1367AB">
        <File Id="OcrCyr2Recognition" Source="$(var.BinDir)\models\cyrillic_pp-ocrv5_mobile_rec.onnx" KeyPath="yes" />
