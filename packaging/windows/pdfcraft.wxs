<?xml version="1.0" encoding="utf-8"?>
<!--
  Sintec.PDF MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build pdfcraft.wxs installer-ui.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, a desktop shortcut (on by default,
  optional), an App Paths entry, Sintec.PDF registered as a PDF handler (offered under "Open with"
  and in Default apps, never forced as the default), and "Edit with Sintec.PDF" on PDF files'
  right-click menu (on by default, optional). Files opened with Sintec.PDF arrive on its command
  line.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Sintec.PDF"
      Manufacturer="Sintec LLC"
      Version="$(var.Version)"
      UpgradeCode="771EA5E3-78D5-4B1D-B5BD-193072EFB0B7"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Sintec.PDF" Manufacturer="Sintec LLC" />
    <!-- HKLM registrations must never point into a per-user installation (upstream #305). Allow
         removal of an existing installation even if it was somehow installed per-user. -->
    <Launch Condition="ALLUSERS = 1 OR (Installed AND REMOVE = &quot;ALL&quot;)"
        Message="Sintec.PDF must be installed for all users. Run setup with administrator privileges and ALLUSERS=1; per-user installation is not supported." />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Sintec.PDF is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows Installer requires an Icon id ending in .ico or .exe, or advertised shortcuts and
         Add/Remove Programs show a blank icon (#57). -->
    <Icon Id="PdfcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PdfcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/sintec-llc/sintec.pdf" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/sintec-llc/sintec.pdf/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/sintec-llc/sintec.pdf/issues" />
    <!-- Desktop shortcut (#143): on by default, a checkbox in the full-UI welcome dialog, and
         INSTALLDESKTOPSHORTCUT=0 on the msiexec command line for unattended installs. Secure, so the
         choice made in the (unelevated) UI reaches the elevated install. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />
    <!-- Every install, upgrade, repair and removal of this package writes a verbose log to %TEMP%
         (MSI*.LOG), however it was started (double-click, the in-app updater, Programs), so a
         missing installation on someone's PC can be traced afterwards. -->
    <Property Id="MsiLogging" Value="voicewarmup" />
    <!-- "Edit with PdfCraft" on the right-click menu of PDF files in File Explorer (#682): on by
         default, the same way, and INSTALLPDFCONTEXTMENU=0 for unattended installs without it. -->
    <Property Id="INSTALLPDFCONTEXTMENU" Value="1" Secure="yes" />
    <UIRef Id="PdfcraftInstallerUI" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Sintec.PDF" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Sintec.PDF" Level="1">
      <ComponentGroupRef Id="PdfcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="PdfcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="PdfcraftApp" Guid="77463CAA-0061-4070-AC61-59682288BAE4">
        <File Id="PdfcraftExe" Source="$(var.BinDir)\sintec-pdf.exe" KeyPath="yes" />

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\sintec-pdf.exe" Value="[#PdfcraftExe]" Type="string" />

        <!-- PDF files (#107): Sintec.PDF is offered under "Open with" and in Settings ▸ Default
             apps, through Windows' Default Programs registration (a ProgID, OpenWithProgids,
             Capabilities and RegisteredApplications). It never takes over an existing default:
             .pdf's own default value is left alone, and the user chooses. Without this, the only
             Sintec.PDF entry to pick was the advertised Start Menu shortcut, which Windows can't
             run as a file handler ("This app can't run on your PC"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\SintecPDF.Document" Value="PDF Document" Type="string" />
        <!-- A negative index selects the stable icon resource ID, rather than its position.
             Resource 1 is the app logo; resource 2 is the PDF file icon (apps/pdfcraft/build.rs). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\SintecPDF.Document\DefaultIcon" Value="&quot;[#PdfcraftExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SintecPDF.Document\shell\open\command" Value="&quot;[#PdfcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdf\OpenWithProgids" Name="SintecPDF.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sintec-pdf.exe" Name="FriendlyAppName" Value="Sintec.PDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sintec-pdf.exe\DefaultIcon" Value="&quot;[#PdfcraftExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sintec-pdf.exe\SupportedTypes" Name=".pdf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sintec-pdf.exe\shell\open\command" Value="&quot;[#PdfcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sintec.PDF\Capabilities" Name="ApplicationName" Value="Sintec.PDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sintec.PDF\Capabilities" Name="ApplicationDescription" Value="Open-source PDF workbench" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sintec.PDF\Capabilities" Name="ApplicationIcon" Value="[#PdfcraftExe],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sintec.PDF\Capabilities\FileAssociations" Name=".pdf" Value="SintecPDF.Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="Sintec.PDF" Value="Software\Sintec.PDF\Capabilities" Type="string" />

        <!-- Explorer context menu «Преобразовать в PDF» on PDFs, images, text files and Office
             documents: the selected files become one PDF next to them (the app's convert-to-pdf
             option; Office documents go through the installed Office). Player lets it work on
             any number of files; Windows starts one process per file and the app pools them. No
             file type's default is changed. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\SintecPDF.ConvertToPdf" Value="Преобразовать в PDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\SintecPDF.ConvertToPdf" Name="MultiSelectModel" Value="Player" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\SintecPDF.ConvertToPdf" Name="Icon" Value="[#PdfcraftExe],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\SintecPDF.ConvertToPdf\command" Value="&quot;[#PdfcraftExe]&quot; --convert-to-pdf &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\SintecPDF.ConvertToPdf" Value="Преобразовать в PDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\SintecPDF.ConvertToPdf" Name="MultiSelectModel" Value="Player" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\SintecPDF.ConvertToPdf" Name="Icon" Value="[#PdfcraftExe],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\SintecPDF.ConvertToPdf\command" Value="&quot;[#PdfcraftExe]&quot; --convert-to-pdf &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\SintecPDF.ConvertToPdf" Value="Преобразовать в PDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\SintecPDF.ConvertToPdf" Name="MultiSelectModel" Value="Player" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\SintecPDF.ConvertToPdf" Name="Icon" Value="[#PdfcraftExe],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\SintecPDF.ConvertToPdf\command" Value="&quot;[#PdfcraftExe]&quot; --convert-to-pdf &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\SintecPDF.ConvertToPdf" Value="Преобразовать в PDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\SintecPDF.ConvertToPdf" Name="MultiSelectModel" Value="Player" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\SintecPDF.ConvertToPdf" Name="Icon" Value="[#PdfcraftExe],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\SintecPDF.ConvertToPdf\command" Value="&quot;[#PdfcraftExe]&quot; --convert-to-pdf &quot;%1&quot;" Type="string" />
